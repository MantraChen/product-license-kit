# Run pnpm build && pnpm run init:local to create real local credentials.
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=.data/framework.sqlite
SIGNING_KEY_PATH=.data/signing.pem
ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
LICENSE_ISSUER=product-license-kit
CATALOG_PATH=examples/catalog.json
# KOOK is optional. Its bearer access token is verified remotely during login.
ENABLE_KOOK=false
# TOKEN_IDENTITY_PATH=.data/local-identities.json
# TOKEN_IDENTITY_PATH is a LOCAL DEVELOPMENT adapter. Refused in production.
NODE_ENV=development
# Optional explicit proxy IP/CIDR allowlist; empty does not trust forwarded IPs.
TRUSTED_PROXY_CIDRS=
